{
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": ["gomod", "dockerfile", "github-actions"],
  "postUpdateOptions": ["gomodUpdateImportPaths"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep the Go toolchain directive current; CI and Docker both read go.mod",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Review compatible Go dependency updates together",
      "matchManagers": ["gomod"],
      "matchDepNames": ["!go"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    },
    {
      "description": "Major module migrations require manual API review",
      "matchManagers": ["gomod"],
      "matchDepNames": ["!go"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
